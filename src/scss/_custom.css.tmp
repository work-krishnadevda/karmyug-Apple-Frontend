/* CSS */
.sign-up {
  padding: 8px 5px;
  text-align: center;
  text-transform: uppercase;
  transition: 0.5s;
  background-size: 200% auto;
  color: white;
  border-radius: 10px;
  border: 0px;
  width: 100%;
  font-weight: 700;
  background: #222b40;
  cursor: pointer;
  user-select: none;
  -webkit-user-select: none;
  touch-action: manipulation;
}

.sign-up:hover {
  background-position: right center;
  /* change the direction of the change here */
  color: #fff;
  text-decoration: none;
}

.sign-up:active {
  transform: scale(0.95);
}

.modal-open {
