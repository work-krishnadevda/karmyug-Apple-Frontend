.w-5 {
  width: 5% !important;
}

.w-8 {
  width: 8% !important;
}

.w-30 {
  width: 30% !important;
}

.w-20 {
  width: 20% !important;
}

.w-10 {
  width: 10%;
}

.w-17 {
  width: 17%;
  text-align: center;
}

.w-18 {
  width: 18%;
}

.w-35 {
  width: 35% !important;
}

.w-40 {
  width: 40% !important;
}

.w-45 {
  width: 45% !important;
}

.w-50 {
  width: 50%;
}

.w-55 {
  width: 55% !important;
}

.w-60 {
  width: 60% !important;
}

.w-65 {
  width: 65% !important;
}

.w-70 {
  width: 70% !important;
}

.w-100 {
  width: 100%;
}

.col-4 {
  width: 33.33%;
}

.avatar-img {
  height: 100%;
}

.fs-12 {
  font-size: 12px !important;
}

.fw-500 {
  font-weight: 500;
}

.bg-1 {
  background-color: #452b90 !important;
}

.bg-2 {
  background-color: #3a9b94 !important;
}

.bg-3 {
  background-color: var(--black) !important;
}

.bg-4 {
  background-color: #a54873 !important;
}

.datatable {
  border-radius: 10px 10px 0 0;
}

.case-table-theme {
  --case-primary: #066054;
  --case-primary-dark: #044b42;
  --case-primary-light: rgba(6, 96, 84, 0.12);
  --case-primary-light-2: rgba(6, 96, 84, 0.06);
  --case-bg: #ffffff;
  --case-surface: #ffffff;
  --case-border: #e5ece9;
  --case-border-strong: #d7e4df;
  --case-text: #111111;
  --case-text-light: #555;
  --case-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
  background: #ffffff;
  border-radius: 22px;
  padding: 12px;
}

.case-table-theme .case-table-shell {
  border: 1px solid var(--case-border);
  border-radius: 20px;
  overflow: hidden;
  box-shadow: var(--case-shadow);
  background: #fff;
}

.case-table-theme .case-table-shell__header {
  background: linear-gradient(135deg, #066054 0%, #044b42 100%);
  color: #fff;
  border-bottom: 0;
  padding: 16px 20px;
}

.case-table-theme .case-table-shell__header-row {
  gap: 12px;
}

.case-table-theme .case-table-shell__title {
  color: #fff;
  font-size: 16px;
  font-weight: 700;
  letter-spacing: 0.02em;
}

.case-table-theme .case-table-shell__filter-btn {
  background: #ffffff !important;
  color: #044b42 !important;
  border: 1px solid rgba(255, 255, 255, 0.35) !important;
  box-shadow: 0 4px 12px rgba(4, 75, 66, 0.15);
}

.case-table-theme .case-table-shell__filter-btn:hover,
.case-table-theme .case-table-shell__filter-btn:focus,
.case-table-theme .case-table-shell__filter-btn:focus-visible {
  background: #f1fbf9 !important;
  color: #044b42 !important;
  border-color: rgba(255, 255, 255, 0.6) !important;
  box-shadow: 0 6px 16px rgba(4, 75, 66, 0.2);
}

/* Main Table */
.case-table-theme .datatable {
  overflow: visible;
  background: var(--case-surface);
  border: 1px solid var(--case-border);
  border-radius: 20px;
  box-shadow: var(--case-shadow);
}

/* Table Wrapper */
.case-table-theme .rdt_Table,
.case-table-theme .rdt_TableWrapper,
.case-table-theme .rdt_ResponsiveWrapper,
.case-table-theme .rdt_TableBody {
  background: #fff;
  overflow: visible;
  position: relative;
  z-index: 1;
}

/* Header */
.case-table-theme .rdt_TableHeadRow {
  min-height: 58px;
  background: linear-gradient(180deg, #ffffff 0%, #f6fbf9 100%);
  border-bottom: 1px solid var(--case-border-strong);
}

/* Header Text */
.case-table-theme .rdt_TableCol,
.case-table-theme .rdt_TableCol_Sortable,
.case-table-theme .rdt_TableHeadRow .rdt_TableCol {
  color: var(--case-text);
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 0.25px;
  text-transform: uppercase;
}

/* Table Rows */
.case-table-theme .rdt_TableRow {
  min-height: 64px;
  background: #fff;
  border-bottom: 1px solid #f1f4f3;
  transition: all 0.2s ease;
  position: relative;
  z-index: 1;
}

/* Alternate Row */
.case-table-theme .rdt_TableRow:nth-child(even) {
  background: #fcfdfd;
}

/* Hover Effect */
.case-table-theme .rdt_TableRow:hover {
  background: var(--case-primary-light) !important;
  box-shadow: inset 4px 0 0 var(--case-primary);
  transform: translateY(-1px);
}

.case-table-theme .rdt_TableRow td {
  padding-top: 13px;
  padding-bottom: 13px;
}

/* Cell Text */
.case-table-theme .rdt_TableCell,
.case-table-theme .data_table_colum,
.case-table-theme .fs-12 {
  color: var(--case-text);
  font-weight: 500;
  transition: color 0.2s ease;
}

/* Hover Text */
.case-table-theme .rdt_TableRow:hover .data_table_colum,
.case-table-theme .rdt_TableRow:hover .fs-12,
.case-table-theme .rdt_TableRow:hover .rdt_TableCell {
  color: #000;
}

/* Pagination */
.case-table-theme .rdt_Pagination {
  background: #fff;
  border-top: 1px solid var(--case-border);
  min-height: 60px;
}

/* Pagination Buttons */
.case-table-theme .rdt_Pagination button,
.case-table-theme .rdt_Pagination select {
  border-radius: 10px;
  transition: all 0.2s ease;
  color: var(--case-text);
}

/* Pagination Hover */
.case-table-theme .rdt_Pagination button:hover:not(:disabled),
.case-table-theme .rdt_Pagination select:hover {
  background: var(--case-primary-light);
  border-color: var(--case-primary) !important;
  color: var(--case-primary) !important;
}

/* Focus */
.case-table-theme .rdt_Pagination button:focus-visible,
.case-table-theme .rdt_Pagination select:focus-visible {
  outline: 2px solid rgba(6, 96, 84, 0.3);
  outline-offset: 2px;
}

/* Action Buttons Container */
.case-table-theme .action-btn {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  flex-wrap: nowrap;
  gap: 10px;
  white-space: nowrap;
  line-height: 1;
  overflow: visible;
  position: relative;
}

.case-table-theme .case-action-cell {
  position: relative;
  align-items: center;
  gap: 10px;
  overflow: visible;
  z-index: 20;
}

.case-table-theme .case-action-dropdown-wrap {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: flex-start;
  overflow: visible;
  z-index: 2000;
}

.case-table-theme .case-action-status-chip {
  min-width: 82px;
  height: 34px;
  padding: 0 12px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  border: 1px solid rgba(6, 96, 84, 0.2);
  border-radius: 12px;
  background: #ffffff;
  font-size: 12px;
  font-weight: 700;
  line-height: 1;
  box-shadow: 0 1px 2px rgba(16, 24, 40, 0.04);
}

.case-table-theme .case-action-status-chip__dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  flex-shrink: 0;
  background: var(--case-primary);
  box-shadow: 0 0 0 3px rgba(6, 96, 84, 0.12);
}

.case-table-theme .case-action-status-chip--live {
  color: var(--case-primary-dark);
}

.case-table-theme .case-action-status-chip--hold {
  color: #d94872;
  border-color: rgba(217, 72, 114, 0.18);
}

.case-table-theme .case-action-status-chip--hold .case-action-status-chip__dot {
  background: #d94872;
  box-shadow: 0 0 0 4px rgba(217, 72, 114, 0.12);
}

/* Common Button Style */
.case-table-theme .edit-btn,
.case-table-theme .delet-btn,
.case-table-theme .download-btn,
.case-table-theme .holded-btn,
.case-table-theme .live-btn {
  border: 1px solid transparent;
  border-radius: 12px;
  padding: 7px 12px;
  background: #fff;
  color: var(--case-primary);
  font-weight: 600;
  line-height: 1;
  min-height: 34px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  transition: all 0.2s ease;
  cursor: pointer;
  box-shadow: 0 1px 2px rgba(16, 24, 40, 0.04);
}

.case-table-theme .action-btn .edit-btn,
.case-table-theme .action-btn .delet-btn,
.case-table-theme .action-btn .download-btn {
  width: 36px;
  min-width: 36px;
  padding: 0;
  height: 36px;
}

.case-table-theme .action-btn .edit-btn svg,
.case-table-theme .action-btn .delet-btn svg,
.case-table-theme .action-btn .download-btn svg,
.case-table-theme .action-btn .edit-btn i,
.case-table-theme .action-btn .delet-btn i,
.case-table-theme .action-btn .download-btn i,
.case-table-theme .action-btn .edit-btn .fa-icon,
.case-table-theme .action-btn .delet-btn .fa-icon,
.case-table-theme .action-btn .download-btn .fa-icon {
  width: 16px !important;
  height: 16px !important;
  font-size: 16px !important;
  line-height: 1 !important;
  display: block;
  flex-shrink: 0;
}

.case-table-theme .action-btn .edit-btn,
.case-table-theme .action-btn .delet-btn {
  border-radius: 11px;
}

.case-table-theme .action-btn .download-btn {
  border-radius: 11px;
}

.case-table-theme .action-btn .edit-btn.pointer_cursor.px-2,
.case-table-theme .action-btn .delet-btn.pointer_cursor.px-2 {
  padding-left: 0.5rem !important;
  padding-right: 0.5rem !important;
}

.case-table-theme .action-btn > * {
  flex-shrink: 0;
}

/* Button Hover */
.case-table-theme .edit-btn:hover,
.case-table-theme .download-btn:hover,
.case-table-theme .holded-btn:hover,
.case-table-theme .live-btn:hover,
.case-table-theme .delet-btn:hover {
  background: var(--case-primary-light);
  border-color: rgba(6, 96, 84, 0.25);
  color: var(--case-primary-dark);
  transform: translateY(-2px);
  box-shadow: 0 4px 12px rgba(6, 96, 84, 0.15);
}

/* Active Button */
.case-table-theme .edit-btn:active,
.case-table-theme .download-btn:active,
.case-table-theme .holded-btn:active,
.case-table-theme .live-btn:active,
.case-table-theme .delet-btn:active {
  transform: scale(0.96);
}

.case-table-theme .live-btn {
  min-width: 92px;
  border-color: rgba(6, 96, 84, 0.18);
  background: #fff;
  color: var(--case-primary-dark);
}

.case-table-theme .holded-btn {
  min-width: 92px;
  border-color: rgba(253, 57, 122, 0.18);
  background: #fff;
  color: #d94872;
}

.case-table-theme .live-btn .live_point {
  position: relative;
  top: auto;
  left: auto;
  transform: none;
  width: 7px;
  height: 7px;
  margin-right: 2px;
  flex-shrink: 0;
  background-color: var(--case-primary);
  box-shadow: 0 0 0 4px rgba(6, 96, 84, 0.15);
}

.case-table-theme .live-btn,
.case-table-theme .holded-btn {
  gap: 8px;
  padding-left: 14px;
  padding-right: 14px;
}

.case-table-theme .live-btn::before {
  content: "";
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--case-primary);
  box-shadow: 0 0 0 4px rgba(6, 96, 84, 0.15);
  flex-shrink: 0;
}

.case-table-theme .holded-btn::before {
  content: "";
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #fd397a;
  box-shadow: 0 0 0 4px rgba(253, 57, 122, 0.12);
  flex-shrink: 0;
}

.case-table-theme .action-btn .btn {
  min-height: 34px;
  border-radius: 11px;
  padding-top: 6px;
  padding-bottom: 6px;
  line-height: 1;
}

.case-table-theme .case-action-dropdown {
  width: 100%;
  position: relative;
  z-index: 40;
}

.case-table-theme .case-action-dropdown.show {
  position: relative;
  z-index: 9999 !important;
  isolation: isolate;
}

.case-table-theme .case-action-trigger {
  min-width: 96px;
  height: 34px;
  padding: 0 10px;
  border: 1px solid rgba(6, 96, 84, 0.28) !important;
  border-radius: 12px !important;
  background: #ffffff !important;
  color: var(--case-primary-dark) !important;
  display: inline-flex;
  align-items: center;
  justify-content: space-between;
  gap: 6px;
  box-shadow: 0 1px 2px rgba(16, 24, 40, 0.04);
  transition: all 0.2s ease;
  position: relative;
  z-index: 1;
}

.case-table-theme .case-action-trigger:hover,
.case-table-theme .case-action-trigger:focus,
.case-table-theme .case-action-trigger:focus-visible {
  border-color: #066054 !important;
  box-shadow: 0 0 0 4px rgba(6, 96, 84, 0.16);
  background: #066054 !important;
  color: #ffffff !important;
  transform: translateY(-1px);
}

.case-table-theme .case-action-trigger:hover .case-action-trigger__label,
.case-table-theme .case-action-trigger:focus .case-action-trigger__label,
.case-table-theme .case-action-trigger:focus-visible .case-action-trigger__label,
.case-table-theme .case-action-trigger:hover .case-action-trigger__icon,
.case-table-theme .case-action-trigger:focus .case-action-trigger__icon,
.case-table-theme .case-action-trigger:focus-visible .case-action-trigger__icon,
.case-table-theme .case-action-trigger:hover .case-action-trigger__caret,
.case-table-theme .case-action-trigger:focus .case-action-trigger__caret,
.case-table-theme .case-action-trigger:focus-visible .case-action-trigger__caret {
  color: #ffffff !important;
}

.case-table-theme .case-action-trigger__tone {
  display: inline-flex;
  align-items: center;
  min-width: 58px;
  justify-content: center;
  padding: 5px 10px;
  border-radius: 999px;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.02em;
}

.case-table-theme .case-action-trigger__tone--live {
  color: var(--case-primary-dark);
  background: rgba(6, 96, 84, 0.12);
}

.case-table-theme .case-action-trigger__tone--hold {
  color: #d94872;
  background: rgba(217, 72, 114, 0.12);
}

.case-table-theme .case-action-trigger__icon {
  width: 13px !important;
  height: 13px !important;
  color: var(--case-primary);
  flex-shrink: 0;
}

.case-table-theme .case-action-trigger__icon-wrap {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 14px;
  height: 14px;
  flex-shrink: 0;
}

.case-table-theme .case-action-trigger__label {
  font-size: 12px;
  font-weight: 700;
  color: var(--case-primary-dark);
  letter-spacing: 0.02em;
}

.case-table-theme .case-action-trigger__caret {
  width: 9px !important;
  height: 9px !important;
  flex-shrink: 0;
  opacity: 0.9;
  color: var(--case-primary);
}

.case-table-theme .case-action-menu {
  min-width: 280px;
  max-width: min(320px, 100vw - 32px);
  padding: 10px 0;
  border: 1px solid var(--case-border);
  border-radius: 18px;
  box-shadow: 0 18px 36px rgba(21, 45, 38, 0.14);
  background: #fff !important;
  background-image: none !important;
  background-clip: padding-box;
  opacity: 1;
  z-index: 20000 !important;
  margin-top: 8px;
  overflow: visible;
  pointer-events: auto;
  isolation: isolate;
  transform-origin: top right;
}

.case-table-theme .case-action-menu,
.case-table-theme .case-action-menu * {
  color: var(--case-text);
}

.case-table-theme .case-action-dropdown-wrap .dropdown-menu,
.case-table-theme .case-action-dropdown .dropdown-menu {
  margin-top: 8px;
  z-index: 20000 !important;
}

.case-table-theme .case-action-dropdown.show .case-action-trigger {
  z-index: 20001;
}

.case-table-theme .case-action-dropdown.show .case-action-menu {
  z-index: 20002 !important;
}

.case-table-theme .case-action-menu__summary {
  padding: 6px 10px 10px;
  margin-bottom: 8px;
  border-bottom: 1px solid #eef3f0;
}

.case-table-theme .case-action-menu__state {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 60px;
  padding: 4px 10px;
  border-radius: 999px;
  font-size: 11px;
  font-weight: 700;
  margin-bottom: 8px;
}

.case-table-theme .case-action-menu__state--live {
  color: var(--case-primary-dark);
  background: rgba(6, 96, 84, 0.12);
}

.case-table-theme .case-action-menu__state--hold {
  color: #d94872;
  background: rgba(217, 72, 114, 0.12);
}

.case-table-theme .case-action-menu__text {
  display: block;
  color: var(--case-text);
  font-size: 12px;
  font-weight: 600;
}

.case-table-theme .case-action-menu__item {
  display: flex !important;
  align-items: center !important;
  gap: 18px !important;
  min-height: 44px !important;
  border-radius: 0;
  margin-bottom: 0;
  color: var(--case-text) !important;
  font-size: 13px;
  padding: 11px 18px !important;
  width: 100%;
  justify-content: flex-start !important;
  white-space: nowrap;
}

.case-table-theme .case-action-menu__item:last-child {
  margin-bottom: 0;
}

.case-table-theme .case-action-menu__item + .case-action-menu__item {
  border-top: 1px solid #f3f7f5;
}

.case-table-theme .case-action-menu__item:hover,
.case-table-theme .case-action-menu__item:focus {
  background: rgba(6, 96, 84, 0.18) !important;
  color: var(--case-primary-dark) !important;
}

.case-table-theme .case-action-menu__item:hover .case-action-menu__icon,
.case-table-theme .case-action-menu__item:focus .case-action-menu__icon {
  color: var(--case-primary-dark) !important;
}

.case-table-theme .case-action-menu .dropdown-item {
  width: 100%;
  margin: 0;
}

.case-table-theme .case-action-menu__item--danger:hover,
.case-table-theme .case-action-menu__item--danger:focus {
  background: rgba(253, 57, 122, 0.08);
  color: #c2185b;
}

.case-table-theme .case-action-menu__icon {
  width: 14px !important;
  height: 14px !important;
  flex-shrink: 0;
  color: var(--case-primary) !important;
  margin-right: 4px !important;
}

.case-table-theme .case-action-menu__icon--danger {
  color: #d94872 !important;
}

.case-table-theme .case-action-menu__icon--success {
  color: var(--case-primary-dark) !important;
}

.case-table-theme input[type=checkbox] {
  accent-color: var(--case-primary);
}

.case-table-theme .rdt_Table input[type=checkbox] {
  width: 16px;
  height: 16px;
  cursor: pointer;
  accent-color: var(--case-primary);
}

.case-table-theme .rdt_TableRow,
.case-table-theme .rdt_TableCell {
  overflow: visible;
}

/* Badge */
.case-table-theme .CBadge,
.case-table-theme .badge {
  border-radius: 999px;
  font-weight: 600;
  padding: 6px 12px !important;
  min-height: 28px;
  display: inline-flex;
  align-items: center;
}

.case-table-theme .badge,
.case-table-theme .CBadge {
  background: #066054 !important;
  color: #fff !important;
}

.case-table-theme .badge[style*="#FFD700"],
.case-table-theme .badge[style*="#FF00FF"],
.case-table-theme .badge[style*="#FFA500"],
.case-table-theme .badge[style*="#FF6600"] {
  color: #1f2b28 !important;
}

/* Highlighted Row */
.case-table-theme .datatable .rdt_TableRow[style*="rgba(255, 193, 7, 0.25)"] {
  background: rgba(6, 96, 84, 0.08) !important;
}

.case-table-theme .rdt_TableRow[style*="rgba(255, 193, 7, 0.25)"] {
  background: rgba(6, 96, 84, 0.08) !important;
}

.case-table-theme .rdt_TableRow[style*="rgba(34, 197, 94, 0.08)"],
.case-table-theme .rdt_TableRow[style*="rgba(6, 96, 84, 0.08)"] {
  background: rgba(6, 96, 84, 0.08) !important;
}

/* Scrollbar */
.case-table-theme ::-webkit-scrollbar {
  width: 8px;
  height: 8px;
}

.case-table-theme ::-webkit-scrollbar-thumb {
  background: rgba(6, 96, 84, 0.35);
  border-radius: 20px;
}

.case-table-theme ::-webkit-scrollbar-thumb:hover {
  background: rgba(6, 96, 84, 0.55);
}

.btn-danger {
  background-color: #a90909;
  border-color: #a90909;
}

.btn-warning {
  color: #fff;
}

.datatable .rdt_Pagination {
  border-radius: 0px 0px 10px 10px;
}

.card {
  border-radius: 10px;
  box-shadow: rgba(149, 157, 165, 0.2) 0px 8px 24px;
}

.generate_report {
  color: #222b40 !important;
  font-weight: 500;
}

.Inactive {
  background: #c71717;
  border-radius: 5px;
  color: #fff !important;
  padding: 8px 15px !important;
  width: 5rem;
  text-align: center;
  font-weight: 500;
}

.Active {
  background-color: #008000;
  border-radius: 5px;
  color: #fff !important;
  padding: 8px 15px !important;
  width: 5rem;
  text-align: center;
  font-weight: 500;
}

.user_profile_img {
  width: 35px;
  height: 35px;
  border-radius: 100%;
}

.custm_link {
  color: #73b33c;
  font-weight: 500;
  text-decoration: none;
}

.user_profile_img img {
  width: 100%;
  height: 100%;
  border-radius: 100%;
}

.submit_btn {
