  margin-right: 4px;
  /* Add some spacing between the star and the label text */
}

/* Add margin or padding to create space between radio buttons and labels */
.form-check.maleBtn,
.form-check.femaleBtn {
  margin-right: 10px;
  /* Adjust this value as needed */
}

