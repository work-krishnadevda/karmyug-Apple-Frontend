.table-container table {
  vertical-align: baseline;
}
.table-container table thead th {
  font-weight: 500;
  padding: 1rem;
  border: 1px solid #ebedf2;
}
.table-container table tbody {
  vertical-align: baseline;
}
.table-container table tbody td {
  border: 1px solid #ebedf2;
  background: transparent;
}
.table-container .product_variant_table {
  width: 180%;
}
.table-container .no-image-container {
  position: relative;
  display: inline-block;
}
.table-container .no-image-container .no-image-placeholder {
  cursor: pointer;
  /* Add pointer cursor to indicate it's clickable */
}
.table-container .no-image-container .no-image-placeholder img {
  width: 65px;
  height: 65px;
  background: #fff;
  border-radius: 10px;
  /* margin-top: 20px; */
  border: 1px solid #d2d2d5;
  object-fit: cover;
  box-shadow: rgba(100, 100, 111, 0.2) 0px 7px 29px 0px;
}
.table-container .no-image-container .form-control {
  position: absolute;
  top: 0;
  left: 0;
  opacity: 0;
  /* Make the input transparent to hide it */
  width: 100%;
  height: 100%;
  cursor: pointer;
}
.table-container .preview_image img {
  width: 65px;
  height: 65px;
  margin: 0px;
  box-shadow: rgba(100, 100, 111, 0.2) 0px 7px 29px 0px;
}

