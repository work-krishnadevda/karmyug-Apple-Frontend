}

.gradient4 {
  background: linear-gradient(90deg, rgb(255, 82, 20) 0%, #373954 0%, #6a0909 100%);
  border: 0;
}

.gradient5 {
  background: linear-gradient(90deg, rgb(255, 82, 20) 0%, #0a0d41 0%, #06795f 100%);
