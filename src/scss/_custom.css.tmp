  font-size: 13px;
}

.timeline .timeline-item:after {
  position: absolute;
  display: block;
  top: 0;
}

.timeline .timeline-item:after {
  background-color: #ffb822;
  left: -26px;
  border-radius: 50%;
  height: 11px;
  width: 11px;
  top: 4px;
  content: "";
}

.font-small-size {
  font-size: 14px;
}

.font-small-size-data {
  font-size: 13px;
}

.multi-step .form-label {
  text-transform: capitalize !important;
}
.multi-step input {
  margin-bottom: 0px;
}

.form-select:focus {
  box-shadow: none;
  border-color: #d8dbe0;
}

.coo-form .form-check {
  display: flex;
  align-items: center;
}
.coo-form .form-check .form-check-input {
  margin-right: 10px !important;
}

.view-pdf {
  height: 720px;
  overflow: auto;
}
.view-pdf table {
  border-collapse: collapse;
  table-layout: fixed;
}
.view-pdf th,
.view-pdf td {
  border: 1px solid black;
  padding: 8px;
  text-align: left;
}
.view-pdf th {
  background-color: #f2f2f2;
  font-weight: bold;
}
.view-pdf .title {
  text-align: center;
  font-weight: bold;
}
.view-pdf .subtitle {
  font-weight: bold;
}

.custome-step-nav .ui {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rem;
  height: 100%;
  padding: 4rem;
}
.custome-step-nav .nav {
  background: var(--clr-bg);
  border-radius: 0.5rem;
  padding: 0.375rem;
  font-size: 1.25rem;
}
.custome-step-nav .nav ul {
  display: flex;
  align-items: stretch;
  list-style: none;
}
.custome-step-nav .nav li + li {
  border-left: 1px solid #ffb822;
}
.custome-step-nav .nav li:first-child,
.custome-step-nav .nav li:last-child {
  overflow: hidden;
}
.custome-step-nav .nav li:first-child {
  border-top-left-radius: 0.375rem;
  border-bottom-left-radius: 0.375rem;
}
.custome-step-nav .nav li:first-child a {
  padding: 0.375rem 0.5rem;
}
.custome-step-nav .nav li:last-child {
  border-top-right-radius: 0.375rem;
  border-bottom-right-radius: 0.375rem;
}
.custome-step-nav .nav svg {
  display: block;
  width: 1.25em;
  height: 1.25em;
  color: var(--clr-text-dark);
}
.custome-step-nav .nav a {
  display: flex;
  align-items: center;
  height: 100%;
  padding: 0.375rem 1.25rem;
  border: 1px solid #ffb822;
  color: var(--clr-text);
  text-decoration: none;
  text-shadow: 0 1px 1px #ffb822;
  background-color: #ffb822;
  background-image: linear-gradient(to top, var(--clr-theme-dark), var(--clr-theme));
}
.custome-step-nav .nav a:hover, .custome-step-nav .nav a:focus-visible {
  background-color: var(--clr-theme-dark);
  background-image: linear-gradient(to bottom, var(--clr-theme-dark), var(--clr-theme));
}
.custome-step-nav .steps {
  background: var(--clr-bg);
  border-radius: 0.5rem;
  padding: 0.25rem;
  font-size: 1.125rem;
}
.custome-step-nav .steps ol {
  display: flex;
  align-items: stretch;
  list-style: none;
  padding: 0px;
}
.custome-step-nav .steps a {
  display: flex;
  align-items: center;
  height: 100%;
  padding: 0.375rem 1rem;
  color: #fff;
  text-decoration: none;
  text-shadow: 0 1px 1px var(--clr-text-dark);
}
.custome-step-nav .steps [aria-current] {
  padding: 0.375rem 2rem;
  border: 1px solid #ffb822;
  color: #fff;
  background-color: #ffb822;
  background-image: linear-gradient(to top, var(--clr-theme-dark), var(--clr-theme));
  clip-path: polygon(0% 0%, 1rem 50%, 0% 100%, calc(100% - 1rem) 100%, 100% 50%, calc(100% - 1rem) 0%);
}
.custome-step-nav section {
  height: 600px;
  background-image: linear-gradient(to bottom, rgba(0, 121, 193, 0.75) 0%, rgba(70, 93, 255, 0.75) 100%), url(http://bluebeam.com/uk/bluebeamchallenge/_assets/bg-hero.jpg);
}
.custome-step-nav section h1 {
  margin-top: 50px;
  margin-bottom: 350px;
  color: rgb(255, 255, 255);
}
.custome-step-nav p {
  font-family: "Source Sans Pro", sans-serif;
  font-size: 18px;
}
.custome-step-nav h2 {
  font-family: "Roboto", sans-serif;
}
.custome-step-nav .timeline {
  width: 100%;
  position: relative;
  perspective: 5000px;
}
.custome-step-nav .timeline:before {
  position: absolute;
  content: "";
  width: 100%;
  height: 15px;
  background-color: rgb(213, 223, 229);
  border-radius: 15px;
  top: 76px;
}
.custome-step-nav .timeline .timeline-item {
  text-align: center;
  position: relative;
  z-index: 1;
  cursor: pointer;
}
.custome-step-nav .timeline .timeline-item:hover:after {
  transform: scale(1.5, 1.5);
}
.custome-step-nav .timeline .timeline-item.selected:after {
  background-color: rgb(28, 119, 195);
  border: 5px solid rgb(86, 203, 249);
  transform: scale(1.5, 1.5);
}
.custome-step-nav .timeline .timeline-item:after {
  width: 30px;
  height: 30px;
  position: absolute;
  top: 69px;
  left: 50%;
  margin-left: -15px;
  background-color: rgb(245, 239, 237);
  border: 5px solid rgb(213, 223, 229);
  content: "";
  border-radius: 50%;
  transition: transform 0.5s ease;
}
.custome-step-nav .timeline .timeline-item .timeline-content {
  position: absolute;
  top: -300px;
  display: none;
  width: 350px;
  left: -60px;
  cursor: auto;
}
.custome-step-nav .timeline .timeline-item .timeline-content.fadeIn {
  animation-delay: 0.2s;
}
.custome-step-nav .timeline .timeline-item .timeline-content.animated {
  display: block;
}
.custome-step-nav .flex-container {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  justify-content: flex-start;
  align-content: flex-start;
  align-items: flex-start;
}
.custome-step-nav .flex-items-default {
  width: 224px;
  height: 150px;
}
.custome-step-nav .dropdown {
  width: 400px;
  height: 326px;
  background: rgb(255, 255, 255);
  box-shadow: 0 3px 20px 1px rgba(0, 0, 0, 0.1);
  border-radius: 5px;
  position: absolute;
  top: -310px;
  animation-duration: 0.2s;
  transition: left 0.3s ease;
}
.custome-step-nav .dropdown .inner {
  position: relative;
  width: 100%;
  height: 326px;
}
.custome-step-nav .dropdown .inner .arrow-down {
  position: absolute;
  bottom: -19px;
  left: 50%;
  margin-left: -20px;
}
.custome-step-nav .arrow-down {
  width: 0;
  height: 0;
  border-left: 20px solid transparent;
  border-right: 20px solid transparent;
  border-top: 20px solid rgb(255, 255, 255);
}
.custome-step-nav .animated {
  display: block;
}
.custome-step-nav .material-icons {
  position: absolute;
  top: 189px;
  left: 160px;
  width: 100%;
  color: rgb(255, 255, 255);
  font-size: 33px;
}
.custome-step-nav .hexagon {
  position: relative;
  width: 75px;
  height: 43.3px;
  background-color: rgb(28, 119, 195);
  margin: 21.65px 0;
  left: 50%;
  margin-left: -37px;
  top: 25px;
}
.custome-step-nav .hexagon:before,
.custome-step-nav .hexagon:after {
  content: "";
  position: absolute;
  width: 0;
  border-left: 37.5px solid transparent;
  border-right: 37.5px solid transparent;
}
.custome-step-nav .hexagon:before {
  bottom: 100%;
  border-bottom: 21.65px solid rgb(28, 119, 195);
}
.custome-step-nav .hexagon:after {
  top: 100%;
  width: 0;
  border-top: 21.65px solid rgb(28, 119, 195);
}

.floorTableHeader {
  font-size: 20px;
}

.custom_stepss {
  /* #heading {
      text-transform: uppercase;
      color: rgb(9 54 50);
      font-weight: normal;
  } */
}
.custom_stepss #editmyaccount {
  position: relative;
  max-height: 46px;
  margin-left: 30px;
}
.custom_stepss #editmyaccount #msform {
  height: 100%;
}
.custom_stepss #editmyaccount #progressbar li:after {
  content: "";
  width: 100%;
  height: 6px;
  border-radius: 2px;
  background: none;
  position: absolute;
  left: 0;
  top: 25px;
  z-index: -1;
}
.custom_stepss #editmyaccount .login-anchore {
  color: rgb(9, 54, 50) !important;
}
.custom_stepss #editmyaccount .btn {
  background-color: rgb(9, 54, 50) !important;
  width: 50% !important;
  padding: 8px !important;
}
.custom_stepss #editmyaccount .btn:hover {
  border-color: rgb(9, 54, 50) !important;
}
.custom_stepss #editmyaccount .lefthand-side {
  box-shadow: rgb(51, 51, 51) 0px 1px 19px -17px;
  padding: 45px;
  background-color: rgba(9, 54, 50, 0.95) !important;
}
.custom_stepss #editmyaccount .lefthand-side h1 {
  color: #bd843d;
}
.custom_stepss #editmyaccount .select-option-color {
  color: rgba(86, 81, 81, 0.9294117647) !important;
}
.custom_stepss #editmyaccount html {
  height: 100%;
}
.custom_stepss #editmyaccount p {
  color: grey;
  margin-bottom: 0px;
}
.custom_stepss #editmyaccount #msform {
  text-align: center;
  position: relative;
}
.custom_stepss #editmyaccount #msform fieldset {
  background: white;
  border: 0 none;
  border-radius: 0.5rem;
  box-sizing: border-box;
  width: 100%;
  margin: 0;
  padding-bottom: 20px;
  position: relative;
}
.custom_stepss #editmyaccount .form-card {
  text-align: left;
}
.custom_stepss #editmyaccount #msform fieldset:not(:first-of-type) {
  display: none;
}
.custom_stepss #editmyaccount #msform input,
.custom_stepss #editmyaccount #msform textarea {
  padding: 8px 15px 8px 15px;
  border: 1px solid #ccc;
  border-radius: 0px;
  margin-bottom: 25px;
  margin-top: 2px;
  width: 100%;
  box-sizing: border-box;
  font-family: montserrat;
  color: #2c3e50;
  /* background-color: #ECEFF1; */
  font-size: 16px;
  letter-spacing: 1px;
}
.custom_stepss #editmyaccount #msform input:focus,
.custom_stepss #editmyaccount #msform textarea:focus {
  -moz-box-shadow: none !important;
  -webkit-box-shadow: none !important;
  box-shadow: none !important;
  border: 1px solid rgb(9, 54, 50) !important;
  outline-width: 0;
}
.custom_stepss #editmyaccount #msform .action-button {
  width: 100px;
  background: rgb(9, 54, 50) !important;
  font-weight: bold;
  color: white;
  border: 0 none;
  border-radius: 0px;
  cursor: pointer;
  padding: 10px 5px;
  margin: 10px 0px 10px 5px;
  float: right;
}
.custom_stepss #editmyaccount #msform .action-button:hover,
.custom_stepss #editmyaccount #msform .action-button:focus {
  background-color: rgb(9, 54, 50) !important;
}
.custom_stepss #editmyaccount #msform .action-button-previous {
  width: 100px;
  background: #616161;
  font-weight: bold;
  color: white;
  border: 0 none;
  border-radius: 0px;
  cursor: pointer;
  padding: 10px 5px;
  margin: 10px 5px 10px 0px;
  float: right;
}
.custom_stepss #editmyaccount #msform .action-button-previous:hover,
.custom_stepss #editmyaccount #msform .action-button-previous:focus {
  background-color: #000000;
}
.custom_stepss #editmyaccount .card {
  z-index: 0;
  border: none;
  position: relative;
  padding: 40px !important;
}
.custom_stepss #editmyaccount .fs-title {
  font-size: 25px;
  color: rgb(9, 54, 50) !important;
  margin-bottom: 15px;
  font-weight: normal;
  text-align: left;
}
.custom_stepss #editmyaccount .purple-text {
  color: rgb(9, 54, 50) !important;
  font-weight: normal;
}
.custom_stepss #editmyaccount .steps {
  font-size: 25px;
  color: gray;
  margin-bottom: 12px;
  font-weight: normal;
  text-align: right;
}
.custom_stepss #editmyaccount .fieldlabels {
  color: gray;
  text-align: right;
}
.custom_stepss #editmyaccount #progressbar {
  margin-bottom: 30px;
  overflow: hidden;
  color: lightgrey;
  width: 100%;
}
.custom_stepss #editmyaccount #progressbar .active {
  color: #081632 !important;
}
.custom_stepss #editmyaccount #progressbar {
  color: hsla(218, 58%, 6%, 0.8) !important;
  margin-right: -100px;
  margin-top: -10px;
}
.custom_stepss #editmyaccount #progressbar li {
  list-style-type: none;
  font-size: 15px;
  width: 10%;
  float: left;
  position: relative;
}
.custom_stepss .spinner_outerbox {
  display: flex;
  justify-content: center;
  align-items: center;
  width: 100%;
  height: 100%;
  position: fixed;
  top: 0;
  left: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 9999;
}
.custom_stepss #editmyaccount #progressbar #personaldetails:before {
  font-family: FontAwesome;
  content: "1";
}
.custom_stepss #editmyaccount #progressbar #fe:before {
  font-family: FontAwesome;
  content: "2";
}
.custom_stepss #editmyaccount #progressbar #sdm:before {
  font-family: FontAwesome;
  content: "3";
}
.custom_stepss #editmyaccount #progressbar #dm:before {
  font-family: FontAwesome;
  content: "4";
}
.custom_stepss #editmyaccount #progressbar #rc:before {
  font-family: FontAwesome;
  content: "5";
}
.custom_stepss #editmyaccount #progressbar #lcto:before {
  font-family: FontAwesome;
  content: "6";
}
.custom_stepss #editmyaccount #progressbar #cto:before {
  font-family: FontAwesome;
  content: "7";
}
.custom_stepss #editmyaccount #progressbar #bank:before {
  font-family: FontAwesome;
  content: "8";
}
.custom_stepss #editmyaccount #progressbar li:before {
  width: 30px;
  height: 30px;
  line-height: 30px;
  display: block;
  font-size: 16px;
  color: #ffffff;
  background: lightgray;
  border-radius: 50%;
  margin: 0 auto 5px auto;
  padding: 2px;
  position: relative;
  z-index: 9999;
  margin-right: 190px;
}
.custom_stepss #editmyaccount #progressbar li:after {
  content: "";
  width: 100%;
  height: 6px;
  background: lightgray;
  position: absolute;
  left: 0;
  top: 15px;
  z-index: 0;
}
.custom_stepss #editmyaccount #progressbar li.active:before,
.custom_stepss #editmyaccount #progressbar li.active:after {
  background: #081632 !important;
}
.custom_stepss #editmyaccount #progressbar li.inactive:before,
.custom_stepss #editmyaccount #progressbar li.inactive:after {
  background: lightgray !important;
}
.custom_stepss #editmyaccount .progress {
  height: 20px;
}
.custom_stepss #editmyaccount .progress-bar {
  background-color: #081632 !important;
}
.custom_stepss #editmyaccount .fit-image {
  width: 100%;
  object-fit: cover;
}
.custom_stepss #editmyaccount .multi-col {
  box-shadow: rgba(0, 0, 0, 0.16) 0px 1px 4px;
}
.custom_stepss #editmyaccount .image-box {
  position: relative;
  width: 200px;
}
.custom_stepss #editmyaccount .image-container {
  position: relative;
  display: inline-block;
  width: 200px;
  height: 200px;
  overflow: hidden;
  border: 2px solid #093632;
  padding: 5px;
  border-radius: 7px;
  background: rgba(128, 128, 128, 0.1490196078);
}
.custom_stepss #editmyaccount .edit-delete-icons {
  position: absolute;
  /* top: 5px; */
  right: 9px;
  bottom: 9px;
}
.custom_stepss #editmyaccount .edit-delete-icons i {
  cursor: pointer;
  margin-left: 5px;
  color: #fff;
  font-size: 13px;
  background: #102b29;
  padding: 8px;
  border-radius: 5px;
}
.custom_stepss #editmyaccount #mainImage {
  border-radius: 5px;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: top;
}
.custom_stepss #editmyaccount .hidden-input {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  opacity: 0;
  z-index: -1;
}

