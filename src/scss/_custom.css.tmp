.edit-btn {
  position: relative;
  display: inline-block;
  padding-right: 5px;
  /* Adjust spacing between text and blinking point */
}

.live-btn {
  position: relative;
  display: inline-block;
  color: #008000;
}

.holded-btn {
  position: relative;
  display: inline-block;
  color: rgb(255, 66, 66);
}

.live_point {
  position: absolute;
  top: 57%;
  left: -15px;
  transform: translate(100%, -50%);
  width: 6px;
  height: 6px;
  background-color: #008000;
  border-radius: 50%;
  animation: blink-animation 2s infinite;
}

@keyframes blink-animation {
  0% {
    opacity: 0;
  }
  50% {
    opacity: 1;
  }
  100% {
    opacity: 0;
  }
}
