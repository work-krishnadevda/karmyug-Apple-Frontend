  right: 0;
  content: "";
  position: absolute;
  top: 15px;
  width: 11px;
  transform: rotate(317deg);
}

.react-datepicker__navigation--years-previous:before {
  border-color: #827d7d;
  border-style: solid;
  border-width: 3px 3px 0 0;
  display: block;
  height: 11px;
  left: 35%;
  right: 0;
  content: "";
  position: absolute;
  bottom: 15px;
  width: 11px;
  transform: rotate(134deg);
}

